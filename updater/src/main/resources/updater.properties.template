# ============================================
# 应用自动更新器配置文件模板
# ============================================
# 编码：UTF-8（支持中文值）
# 使用方式：UpdaterConfig.fromFile("/path/to/updater.properties")
# ============================================

# ---------- 服务端配置 ----------

# 服务端主机（IP 或域名，可带 http:// 或 https:// 协议头，缺省补 http://）
server.host=192.168.10.219

# 服务端端口（小于等于 0 时 URL 不带端口）
server.port=8080

# 检查更新接口路径（默认 /public/app-update/check）
server.checkPath=/public/app-update/check

# ---------- 应用标识 ----------

# 应用唯一标识（与服务端登记的 appKey 一致）
app.appKey=兴昊生产扫码入库App

# 平台标识（如 android、ios、windows）
app.platform=android

# 当前应用版本号（整数，与服务端比较判断是否需要更新）
app.currentVersionCode=0

# ---------- 本地路径 ----------

# 更新包下载目录（不存在时自动创建，默认系统临时目录下 updates）
local.downloadDir=/tmp/updates

# 部署脚本路径（可选，为空时跳过部署步骤；下载文件绝对路径作为第一个参数传入）
local.deployScript=/opt/updater/deploy.sh

# 启动脚本路径（可选，为空时跳过启动步骤）
local.startScript=/opt/updater/start.sh

# ---------- 更新行为 ----------

# 网络超时时间（秒，默认 30）
update.timeoutSeconds=30

# 下载失败时是否依次尝试其余下载地址（true/false，默认 true）
update.tryAllUrls=true
