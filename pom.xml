<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>
    <packaging>pom</packaging>

    <!-- ============================== 模块列表 ============================== -->
    <modules>
        <module>app</module>
        <module>web</module>
        <module>async</module>
        <module>common</module>
        <module>cache</module>
        <module>sql</module>
        <module>system</module>
        <module>redis-mod</module>
        <module>mq-mod</module>
        <module>rabbitmq-mod</module>
        <module>push-mod</module>
        <module>shared</module>
        <module>tree-struct</module>
        <module>xxl-job-mod</module>
        <module>open-api-starter</module>
        <module>dynamic-view-route</module>
        <module>script-engine</module>
        <module>dic</module>
        <module>logging</module>
        <module>oss</module>
        <module>updater</module>
        <module>updater-gui</module>
        <module>sdk</module>
    </modules>

    <groupId>com.tbs</groupId>
    <artifactId>solution</artifactId>
    <version>1.0-SNAPSHOT</version>
    <description>abstergo solution 父 POM：统一版本管理、全局依赖、插件配置</description>

    <!-- ============================== 版本属性 ============================== -->
    <properties>
        <!-- 编译/编码 -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 框架版本 -->
        <spring.boot.version>3.3.5</spring.boot.version>
        <spring.cloud.version>2023.0.3</spring.cloud.version>
        <spring.cloud.alibaba.version>2023.0.1.2</spring.cloud.alibaba.version>
        <dubbo.version>3.3.4</dubbo.version>

        <!-- 工具库 -->
        <lombok.version>1.18.30</lombok.version>
        <annotations.version>24.1.0</annotations.version>
        <hutool.version>5.8.22</hutool.version>
        <spring.dotenv.version>4.0.0</spring.dotenv.version>

        <!-- 数据库 / ORM -->
        <mysql.version>8.0.32</mysql.version>
        <tk.mybatis.version>5.0.0</tk.mybatis.version>
        <p6spy.version>3.8.2</p6spy.version>

        <!-- 中间件 -->
        <redisson.version>3.52.0</redisson.version>
        <minio.version>8.5.7</minio.version>
        <!-- MinIO SDK 8.5.x需要okhttp 4.x，覆盖spring-boot父BOM与dubbo-bom管控的3.14.9 -->
        <okhttp3.version>4.12.0</okhttp3.version>

        <!-- 其他三方 -->
        <knife4j.version>4.5.0</knife4j.version>
        <xxl.job.version>2.5.0</xxl.job.version>
        <snakeyaml.version>2.2</snakeyaml.version>
        <kotlin.version>1.7.22</kotlin.version>

        <!-- 内部模块统一版本号：与 project.version 解耦，
             避免个别模块单独改发布版本时污染依赖管理 -->
        <tbs.version>1.0-SNAPSHOT</tbs.version>
    </properties>

    <!-- ============================== 全局依赖（所有子模块继承） ============================== -->
    <dependencies>
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-nacos-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <!-- ============================== 依赖版本管理 ============================== -->
    <dependencyManagement>
        <dependencies>

            <!-- ========== BOM 导入 ========== -->
            <!--
              spring-boot-dependencies 必须最先导入：它把 spring-framework 锁定为 6.1.14（jakarta 命名空间）。
              后续的 dubbo-bom 会在其 dependencyManagement 里把所有 org.springframework:* 降级为 5.3.39（javax），
              而 Maven 对多个 import BOM 采用「先声明者胜」，故此处提前声明可阻止 spring 被拉回 javax。
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring.cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring.cloud.alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-bom</artifactId>
                <version>${dubbo.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ========== 内部模块 — 基础层 ========== -->
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>common</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>async</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>sql</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>web</artifactId>
                <version>${tbs.version}</version>
            </dependency>

            <!-- ========== 内部模块 — 契约层 ========== -->
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>cache-api</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>mq-api</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>push-api</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>push-websocket-impl</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>push-sse-impl</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>shared-pojo</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>shared-api</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>tree-api</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>view-route-api</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>system-api</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>dic-api</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>logging-api</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>script-engine-api</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>oss-api</artifactId>
                <version>${tbs.version}</version>
            </dependency>

            <!-- ========== 内部模块 — 实现层 ========== -->
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>redis</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>cache-impl</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>cache-caffeine-impl</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>default-system-impl</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>closure-list-impl</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>view-route-default-impl</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>rabbitmq-impl</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>rabbitmq-broadcast</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>rabbitmq-logging</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>xxl-job</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>open-api-starter</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>oss-minio-impl</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>updater</artifactId>
                <version>${tbs.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tbs</groupId>
                <artifactId>updater-gui</artifactId>
                <version>${tbs.version}</version>
            </dependency>

            <!-- ========== 外部依赖 ========== -->
            <dependency>
                <groupId>me.paulschwarz</groupId>
                <artifactId>spring-dotenv</artifactId>
                <version>${spring.dotenv.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains</groupId>
                <artifactId>annotations</artifactId>
                <version>${annotations.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>
            <dependency>
                <groupId>mysql</groupId>
                <artifactId>mysql-connector-java</artifactId>
                <version>${mysql.version}</version>
            </dependency>
            <dependency>
                <groupId>tk.mybatis</groupId>
                <artifactId>mapper-spring-boot-starter</artifactId>
                <version>${tk.mybatis.version}</version>
            </dependency>
            <dependency>
                <groupId>tk.mybatis</groupId>
                <artifactId>mapper-extra</artifactId>
                <version>${tk.mybatis.version}</version>
            </dependency>
            <dependency>
                <groupId>p6spy</groupId>
                <artifactId>p6spy</artifactId>
                <version>${p6spy.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xuxueli</groupId>
                <artifactId>xxl-job-core</artifactId>
                <version>${xxl.job.version}</version>
            </dependency>
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>${snakeyaml.version}</version>
            </dependency>
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <!-- MinIO SDK 8.5.x需要okhttp 4.x：dubbo-bom将okhttp管控在3.14.9，
                 且导入的BOM优先级高于spring-boot父POM，故必须在此显式声明覆盖 -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp3.version}</version>
            </dependency>
            <!-- SSE事件流实现（sdk模块使用），版本与okhttp保持一致 -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp-sse</artifactId>
                <version>${okhttp3.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- ============================== 插件管理 ============================== -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.3.0</version>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.2.0</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.8.1</version>
                    <configuration>
                        <source>17</source>
                        <target>17</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
