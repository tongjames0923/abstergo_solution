<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tbs</groupId>
        <artifactId>solution</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>updater-gui</artifactId>

    <description>更新器 GUI 演示程序：依赖 updater 类库，打包为可执行 fat JAR</description>

    <properties>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- 父POM的<dependencies>会被所有子模块继承（spring-boot/dubbo等），
         GUI演示程序不需要这些，用scope=provided覆盖使其不进入runtime classpath，
         assembly打包（scope=runtime）时自动排除，只保留updater及其Jackson传递依赖 -->
    <dependencies>
        <dependency>
            <groupId>com.tbs</groupId>
            <artifactId>updater</artifactId>
        </dependency>
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-nacos-spring-boot-starter</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                打包可执行 fat JAR（包含 updater 类库及其 Jackson 依赖）
                执行: mvn clean package -pl updater-gui -am
                
                运行（Windows 必须加 -Dfile.encoding=UTF-8 避免中文乱码）:
                  java -Dfile.encoding=UTF-8 -jar updater-gui/target/updater-gui-1.0-SNAPSHOT-jar-with-dependencies.jar
                
                Linux/macOS 可直接运行:
                  java -jar updater-gui/target/updater-gui-1.0-SNAPSHOT-jar-with-dependencies.jar
                
                启动后需选择应用配置（updater-{appKey}.properties，位于 JAR 同目录）
                Main-Class 由下方 archive 配置写入，不依赖 MANIFEST.MF 资源文件
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <archive>
                        <manifest>
                            <mainClass>com.tbs.updater.demo.UpdaterGuiDemo</mainClass>
                        </manifest>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>make-fat-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
