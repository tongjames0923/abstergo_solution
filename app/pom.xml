<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tbs</groupId>
        <artifactId>solution</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <groupId>com.tbs</groupId>
    <artifactId>app</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>app</name>
    <description>后端web运行包</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <project.app.version>1.4</project.app.version>
    </properties>

    <dependencies>
        <!-- Nacos配置中心（动态配置） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tbs</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tbs</groupId>
            <artifactId>async</artifactId>
        </dependency>

        <dependency>
            <groupId>com.tbs</groupId>
            <artifactId>default-system-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tbs</groupId>
            <artifactId>cache-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tbs</groupId>
            <artifactId>view-route-default-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tbs</groupId>
            <artifactId>redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tbs</groupId>
            <artifactId>rabbitmq-broadcast</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tbs</groupId>
            <artifactId>rabbitmq-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tbs</groupId>
            <artifactId>closure-list-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tbs</groupId>
            <artifactId>open-api-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tbs</groupId>
            <artifactId>oss-minio-impl</artifactId>
        </dependency>

        <dependency>
            <groupId>com.tbs</groupId>
            <artifactId>push-sse-impl</artifactId>
        </dependency>

        <dependency>
            <groupId>com.tbs</groupId>
            <artifactId>script-engine-api</artifactId>
        </dependency>
        <!-- CDC事件契约：消费cdc-service发出的CdcEvent消息体类型 -->
        <dependency>
            <groupId>com.tbs</groupId>
            <artifactId>cdc-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tbs</groupId>
            <artifactId>cache-caffeine-impl</artifactId>
        </dependency>

        <!--        <dependency>-->
        <!--            <groupId>org.apache.dubbo</groupId>-->
        <!--            <artifactId>dubbo-spring-boot-starter</artifactId>-->
        <!--        </dependency>-->

        <!-- 配置属性元数据生成：编译期自动生成 spring-configuration-metadata.json，
             使 IDE 在 application.yml 中对 app.gateway.* 属性提供自动补全和提示 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                            <!-- 生成 META-INF/build-info.properties，供网关版本接口读取构建版本/时间 -->
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
