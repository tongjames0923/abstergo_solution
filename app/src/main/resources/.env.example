# Zookeeper配置
NACOS_ADDRESS=1127.0.0.1:8848

# Dubbo配置
DUBBO_PORT=20778

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=app_system
DB_USERNAME=root
DB_PASSWORD=123456

# RabbitMQ配置
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
